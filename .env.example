# Opsional. Base URL API berformat eQuran.id v2.
# Kosong = https://equran.id/api/v2
# Sengaja TANPA prefix NEXT_PUBLIC_ — dibaca di server saat request,
# jadi bisa diganti lewat `docker run -e QURAN_API_URL=...` tanpa rebuild image.
QURAN_API_URL=

# Opsional. Base URL audio murottal.
# Kosong = https://cdn.equran.id
QURAN_AUDIO_URL=

# Opsional. Base URL fawazahmed0/quran-api (hanya teks edisi tambahan).
# Kosong = jsDelivr, lalu raw.githubusercontent.com sebagai cadangan.
# Untuk produksi, arahkan ke mirror sendiri yang berstruktur sama.
QURAN_FAWAZ_URL=
