# All variables are optional. They are deliberately NOT prefixed with NEXT_PUBLIC_:
# they are read on the server at request time, so they can be changed with
# `docker run -e QURAN_API_URL=...` without rebuilding the image.

# Base URL of an API in the EQuran.id v2 format. Empty = https://equran.id/api/v2
# It can also be a directory with a local copy of the data (e.g. /data/api/v2), so no
# HTTP request is made at all.
QURAN_API_URL=

# Base URL of the EQuran.id recitation audio. Empty = https://cdn.equran.id
QURAN_AUDIO_URL=

# Base URL of the AlQuran.cloud audio CDN (more reciters). Empty = https://cdn.islamic.network
QURAN_ISLAMIC_AUDIO_URL=

# Base URL of fawazahmed0/quran-api (text of the extra editions).
# Empty = jsDelivr, then raw.githubusercontent.com as a fallback.
# In production, point it to our own mirror (an HTTP URL or a local directory such as
# /data/quran-api), which has the same structure.
QURAN_FAWAZ_URL=

# Path of a JSON file that replaces the built-in source registry: which providers are
# active, in which order, which editions are enabled and the defaults. See
# config/sources.example.json. The three variables above only fill in a baseUrl that the
# file leaves out. Empty = the built-in registry.
QURAN_CONFIG=
