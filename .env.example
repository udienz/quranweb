# All variables are optional. They are deliberately NOT prefixed with NEXT_PUBLIC_:
# they are read on the server at request time, so they can be changed with
# `docker run -e QURAN_API_URL=...` without rebuilding the image.

# Base URL of an API in the EQuran.id v2 format. Empty = https://equran.id/api/v2
QURAN_API_URL=

# Base URL of the recitation audio. Empty = https://cdn.equran.id
QURAN_AUDIO_URL=

# Base URL of fawazahmed0/quran-api (text of the extra editions).
# Empty = jsDelivr, then raw.githubusercontent.com as a fallback.
# In production, point it to our own mirror, which has the same structure.
QURAN_FAWAZ_URL=
