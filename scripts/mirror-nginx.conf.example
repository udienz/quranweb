# nginx example for serving our static data mirrors as APIs. Put the locations inside
# an existing `server { ... }` block and replace /srv/quranweb-mirror with the --out
# directory you used. Then set QURAN_API_URL=https://<domain>/api/v2 and
# QURAN_FAWAZ_URL=https://<domain>/quran-api.

# EQuran.id format (scripts/sync-mirror.mjs):
#   /api/v2/surat    -> surat.json
#   /api/v2/surat/1  -> surat/1.json
#   /api/v2/tafsir/1 -> tafsir/1.json
location /api/v2/ {
    root /srv/quranweb-mirror;
    default_type application/json;
    try_files $uri.json =404;

    add_header Cache-Control "public, max-age=86400";
    add_header Access-Control-Allow-Origin "*";
}

# fawazahmed0/quran-api format (scripts/sync-fawaz.mjs in the quranweb-data repository,
# copied to <root>/quran-api). `.json` and `.min.json` are both served from the
# `.min.json` files.
#
#   /quran-api/editions.json                  -> the catalog of editions
#   /quran-api/info.json                      -> Qur'an metadata (English surah names, ...)
#   /quran-api/editions/<edition>/<surah>.json -> one surah
location ~ ^/quran-api/(.+?)(\.min)?\.json$ {
    root /srv/quranweb-mirror;
    default_type application/json;
    try_files /quran-api/$1.min.json =404;

    add_header Cache-Control "public, max-age=86400";
    add_header Access-Control-Allow-Origin "*";
}
